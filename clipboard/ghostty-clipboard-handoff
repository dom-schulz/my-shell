#!/usr/bin/env python3
"""Hand Ghostty's X11 clipboard over to xclip.

Pasting text that Ghostty owns hangs Chromium and Electron renderers on X11,
while the same text pasted from xclip works. This waits for XFixes
selection-owner events (no polling), and whenever Ghostty takes CLIPBOARD,
it copies the text into xclip so that xclip answers paste requests instead.
"""

import ctypes
import ctypes.util
import subprocess
import sys

GHOSTTY_CLASSES = {b"ghostty", b"com.mitchellh.ghostty"}
XFIXES_SET_SELECTION_OWNER_NOTIFY_MASK = 1


class XFixesSelectionNotifyEvent(ctypes.Structure):
    _fields_ = [
        ("type", ctypes.c_int),
        ("serial", ctypes.c_ulong),
        ("send_event", ctypes.c_int),
        ("display", ctypes.c_void_p),
        ("window", ctypes.c_ulong),
        ("subtype", ctypes.c_int),
        ("owner", ctypes.c_ulong),
        ("selection", ctypes.c_ulong),
        ("timestamp", ctypes.c_ulong),
        ("selection_timestamp", ctypes.c_ulong),
    ]


class XEvent(ctypes.Union):
    _fields_ = [
        ("type", ctypes.c_int),
        ("xfixes_selection", XFixesSelectionNotifyEvent),
        ("pad", ctypes.c_long * 24),
    ]


class XClassHint(ctypes.Structure):
    _fields_ = [("res_name", ctypes.c_void_p), ("res_class", ctypes.c_void_p)]


def load(name):
    path = ctypes.util.find_library(name)
    if not path:
        sys.exit(f"ghostty-clipboard-handoff: lib{name} not found")
    return ctypes.cdll.LoadLibrary(path)


xlib = load("X11")
xfixes = load("Xfixes")

xlib.XOpenDisplay.restype = ctypes.c_void_p
xlib.XOpenDisplay.argtypes = [ctypes.c_char_p]
xlib.XDefaultRootWindow.restype = ctypes.c_ulong
xlib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
xlib.XInternAtom.restype = ctypes.c_ulong
xlib.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
xlib.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.POINTER(XEvent)]
xlib.XGetClassHint.argtypes = [
    ctypes.c_void_p,
    ctypes.c_ulong,
    ctypes.POINTER(XClassHint),
]
xlib.XFree.argtypes = [ctypes.c_void_p]
xlib.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
xfixes.XFixesQueryExtension.argtypes = [
    ctypes.c_void_p,
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_int),
]
xfixes.XFixesSelectSelectionInput.argtypes = [
    ctypes.c_void_p,
    ctypes.c_ulong,
    ctypes.c_ulong,
    ctypes.c_ulong,
]

# The owner window can disappear before we inspect it. Xlib's default error
# handler exits the process, so ignore errors instead.
ERROR_HANDLER = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)
ignore_x_errors = ERROR_HANDLER(lambda display, event: 0)
xlib.XSetErrorHandler(ignore_x_errors)


def is_ghostty(display, window):
    hint = XClassHint()
    if not xlib.XGetClassHint(display, window, ctypes.byref(hint)):
        return False
    names = set()
    for pointer in (hint.res_name, hint.res_class):
        if pointer:
            names.add(ctypes.string_at(pointer))
            xlib.XFree(pointer)
    return bool(names & GHOSTTY_CLASSES)


def hand_off():
    try:
        text = subprocess.run(
            ["xclip", "-o", "-selection", "clipboard", "-t", "UTF8_STRING"],
            capture_output=True,
            timeout=2,
            check=True,
        ).stdout
        # xclip forks and keeps owning the clipboard until something else
        # takes it.
        subprocess.run(
            ["xclip", "-i", "-selection", "clipboard"],
            input=text,
            timeout=2,
            check=True,
        )
    except (subprocess.SubprocessError, OSError) as error:
        print(f"ghostty-clipboard-handoff: {error}", file=sys.stderr, flush=True)


def main():
    display = xlib.XOpenDisplay(None)
    if not display:
        sys.exit("ghostty-clipboard-handoff: cannot open X display")

    event_base = ctypes.c_int()
    error_base = ctypes.c_int()
    if not xfixes.XFixesQueryExtension(
        display, ctypes.byref(event_base), ctypes.byref(error_base)
    ):
        sys.exit("ghostty-clipboard-handoff: XFixes extension unavailable")

    clipboard = xlib.XInternAtom(display, b"CLIPBOARD", False)
    xfixes.XFixesSelectSelectionInput(
        display,
        xlib.XDefaultRootWindow(display),
        clipboard,
        XFIXES_SET_SELECTION_OWNER_NOTIFY_MASK,
    )
    xlib.XSync(display, False)

    event = XEvent()
    while True:
        xlib.XNextEvent(display, ctypes.byref(event))
        if event.type != event_base.value:
            continue
        owner = event.xfixes_selection.owner
        if owner and is_ghostty(display, owner):
            hand_off()


if __name__ == "__main__":
    main()
