theme = light:my-light,dark:my-dark

cursor-style = block
shell-integration-features = no-cursor

# Cmd+Option+arrows move between splits (Ghostty's macOS default; on Linux,
# keyd sends Super+Alt for left Alt + left Super). Cmd+arrows stay free for
# line navigation.
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_down=goto_split:down

# Option+Backspace deletes the previous word (keyd sends Ctrl+Backspace on Linux).
keybind = ctrl+backspace=text:\x17
# Cmd+Backspace deletes to the start of the line (keyd sends Shift+Home first).
keybind = shift+home=text:\x15

# Use the Alt+D and Alt+Shift+D keyd translations to split right and down.
keybind = ctrl+alt+super+d=new_split:right
keybind = ctrl+alt+shift+super+d=new_split:down

# Use the existing Alt+C/V keyd translations as terminal copy/paste.
# Preserve Ctrl+C as an interrupt when there is no selection to copy.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard

# Use the Alt+N keyd translation to open a new window.
keybind = ctrl+n=new_window

# Use the Alt+W keyd translation to close the current split, tab, or window.
keybind = ctrl+w=close_surface
