background = #fafafa
foreground = #383a43
cursor-color = #1a1919
cursor-text = #dbdfe5
selection-background = #454e5e
selection-foreground = #1a1919
palette = 0=#454b58
palette = 1=#f74840
palette = 2=#25a343
palette = 3=#cc8100
palette = 4=#0087c1
palette = 5=#b50da9
palette = 6=#009ab7
palette = 7=#c5b2b3
palette = 8=#0e131f
palette = 9=#ff3711
palette = 10=#00b90e
palette = 11=#ec9900
palette = 12=#1065de
palette = 13=#e500d8
palette = 14=#00b4dd
palette = 15=#ffffff
 
cursor-style = block
shell-integration-features = no-cursor

# Use left Alt (emitted as Super by keyd) to move focus between splits.
keybind = super+arrow_left=goto_split:left
keybind = super+arrow_right=goto_split:right
keybind = super+arrow_up=goto_split:up
keybind = super+arrow_down=goto_split:down

# Use the existing Alt+C/V keyd translations as terminal copy/paste.
# Preserve Ctrl+C as an interrupt when there is no selection to copy.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
