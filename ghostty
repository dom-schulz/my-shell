theme = light:my-light,dark:Adwaita Dark

cursor-style = block
shell-integration-features = no-cursor

# Use left Alt (emitted as Super by keyd) to move focus between splits.
keybind = super+arrow_left=goto_split:left
keybind = super+arrow_right=goto_split:right
keybind = super+arrow_up=goto_split:up
keybind = super+arrow_down=goto_split:down

# Use the existing Alt+C/V keyd translations as terminal copy/paste.
# Preserve Ctrl+C as an interrupt when there is no selection to copy.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard

# Use the Alt+N keyd translation to open a new window.
keybind = ctrl+n=new_window
